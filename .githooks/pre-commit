#!/usr/bin/env bash
# Blocks staged text that adds an em dash. Project rule in AGENTS.md.
# Only added lines are checked, so the hook never fails on untouched content.
set -euo pipefail
emdash=$'\xe2\x80\x94'
hits=$(git diff --cached -U0 --no-color --diff-filter=ACM | grep -n "^+.*$emdash" | grep -v '^[0-9]*:+++ ' || true)
if [[ -n "$hits" ]]; then
  echo "pre-commit: em dash found in staged changes. Use '-' instead (AGENTS.md rule):" >&2
  echo "$hits" >&2
  exit 1
fi
